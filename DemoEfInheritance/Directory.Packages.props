<!-- Uso de Directory.Packages.props para personalizar todos los proyectos en una solución. -->
<Project>
  <!-- Uso de configuración de NuGet Package de .NET para manejo de versiones. Se configura un PackageVersion centralizado con la versión y se omite en el PackageReference. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageVersion Include="CSharpier.MsBuild" Version="0.30.6" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="9.27.0.93347" />
  </ItemGroup>
</Project>
